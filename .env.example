# Copy this file to .env and fill in your own values. Never commit .env.
# Every value below is a placeholder.

# --- required ---
# A long random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Your MySQL password.
DB_PASSWORD=

# --- database (defaults shown) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=student_result_db

# --- application (defaults shown) ---
# Debug mode shows an interactive debugger. Leave it off unless you are developing.
FLASK_DEBUG=0
# 127.0.0.1 = this computer only. Do not change it to 0.0.0.0 on a shared network.
APP_HOST=127.0.0.1
APP_PORT=5000

# --- sessions and sign-in (defaults shown) ---
# Signed out after this many idle minutes.
SESSION_IDLE_MINUTES=30
# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
# Failed sign-ins allowed per account+address, and per address, inside the window.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
